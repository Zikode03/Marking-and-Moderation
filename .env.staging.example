# Copy to .env.staging (ignored). Use separate staging services and secrets.
APP_DOMAIN=staging.example.org
BACKEND_CONTEXT=../Marking-and-Moderation-backend
FRONTEND_REF=REPLACE_WITH_FULL_FRONTEND_COMMIT_SHA
BACKEND_REF=REPLACE_WITH_FULL_BACKEND_COMMIT_SHA
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=assess@example.org
SMTP_USERNAME=assess@example.org
API_DB_SECRET_FILE=./.secrets/staging-api-db.txt
MIGRATION_DB_SECRET_FILE=./.secrets/staging-migration-db.txt
SMTP_PASSWORD_FILE=./.secrets/staging-smtp-password.txt

TENANT_STORAGE_QUOTA_BYTES=10737418240
MONITOR_KEY_FILE=./.secrets/staging-monitor-key.txt
