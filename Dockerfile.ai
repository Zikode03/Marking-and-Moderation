FROM python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f
WORKDIR /service
COPY deploy/requirements.ai.lock /service/requirements.ai.lock
RUN pip install --no-cache-dir --require-hashes -r /service/requirements.ai.lock
COPY ai_training ./ai_training
COPY ai_service ./ai_service
RUN python -c "import torch; from ai_training.runtime import Runner; from ai_service.main import health; assert not health()['ready']"
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "ai_service.main:app", "--host", "0.0.0.0", "--port", "8000"]
